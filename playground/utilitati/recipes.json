{
  "_comment": "Bill extraction recipes. Each furnizor entry defines how to detect and extract fields from PDF text.",
  "furnizori": {
    "engie": {
      "display_name": "ENGIE Romania S.A.",
      "detection": {
        "filename_keywords": ["engie"],
        "content_keywords": ["ENGIE Romania", "engie.ro"]
      },
      "fields": {
        "numar_factura": {
          "patterns": [
            "Seria ENG nr\\.([\\d]+)",
            "nr\\.\\s*([\\d]{10,})"
          ],
          "group": 1,
          "transform": "strip"
        },
        "valoare": {
          "patterns": [
            "Factura curent[aă]:\\s*([\\d]+[,\\.][\\d]+)\\s*LEI",
            "TOTAL DE PLAT(?:Ă|A) CU T\\.V\\.A\\.\\s*[\\d,\\.]+\\s*([\\d,\\.]+)\\s*LEI",
            "TOTAL FACTUR(?:Ă|A) CURENT(?:Ă|A):\\s*[\\d,\\.]+\\s*[\\d,\\.]+\\s*([\\d,\\.]+)"
          ],
          "group": 1,
          "transform": "normalize_decimal",
          "suffix": " LEI"
        },
        "data_facturii": {
          "patterns": [
            "Data facturii:\\s*(\\d{2}\\.\\d{2}\\.\\d{4})"
          ],
          "group": 1,
          "transform": "strip"
        },
        "consum": {
          "patterns": [
            "CONSUM GAZE NATURALE \\(kWh\\)\\s*([\\d,\\.]+)",
            "([\\d,\\.]+)\\s*43,85\\s*LEI"
          ],
          "group": 1,
          "transform": "normalize_decimal",
          "suffix": " kWh",
          "optional": true
        }
      }
    },
    "orange": {
      "display_name": "Orange Romania S.A.",
      "detection": {
        "filename_keywords": ["orange"],
        "content_keywords": ["Orange Romania", "orange.ro", "My Orange"]
      },
      "fields": {
        "numar_factura": {
          "patterns": [
            "Numar factura:\\s*(\\S+)",
            "Referinta interna:\\s*(\\S+)"
          ],
          "group": 1,
          "transform": "strip"
        },
        "valoare": {
          "patterns": [
            "Total factura\\s+\\d+\\s+([\\d,\\.]+)",
            "Total de plata\\s*\\(LEI\\)\\s*([\\d,\\.]+)",
            "Total factura\\s*([\\d,\\.]+)$"
          ],
          "group": 1,
          "transform": "normalize_decimal",
          "suffix": " LEI"
        },
        "data_facturii": {
          "patterns": [
            "Data facturii:\\s*(\\d{2}\\.\\d{2}\\.\\d{4})"
          ],
          "group": 1,
          "transform": "strip"
        },
        "consum": {
          "patterns": [],
          "optional": true,
          "default": "N/A"
        }
      }
    },
    "ppc": {
      "display_name": "PPC Energie S.A.",
      "detection": {
        "filename_keywords": ["ppc", "25ei"],
        "content_keywords": ["PPC Energie", "ppcenergy.ro", "PPC00000"]
      },
      "fields": {
        "numar_factura": {
          "patterns": [
            "Factur(?:ă|a) fiscal(?:ă|a) seria (\\S+) nr\\.\\s*(\\d+)",
            "la factura\\s+(\\w+)"
          ],
          "group": "concat_1_2",
          "transform": "strip"
        },
        "valoare": {
          "patterns": [
            "Total de plat(?:ă|a) \\( 7= 5\\+ 6\\)\\s*lei\\s*([\\d,\\.]+)",
            "Valoare factur(?:ă|a) curent(?:ă|a) \\( 4= 1\\+ 3\\).*?lei\\s*([\\d,\\.]+)",
            "Total de plat(?:ă|a)\\s*\\( 7=.*?\\)\\s*([\\d,\\.]+)"
          ],
          "group": 1,
          "transform": "normalize_decimal",
          "suffix": " LEI"
        },
        "data_facturii": {
          "patterns": [
            "din data de (\\d{2}\\.\\d{2}\\.\\d{4})",
            "Factur(?:ă|a) fiscal(?:ă|a) seria.*?din data de (\\d{2}\\.\\d{2}\\.\\d{4})"
          ],
          "group": 1,
          "transform": "strip"
        },
        "consum": {
          "patterns": [
            "Consum energie activ(?:ă|a)\\s*kWh\\s*(\\d+)",
            "Cantitate de facturat\\s*(\\d+)"
          ],
          "group": 1,
          "transform": "strip",
          "suffix": " kWh",
          "optional": true
        }
      }
    }
  }
}
